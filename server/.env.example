# Copy to .env and adjust. Every setting is prefixed with NESTBOARD_.
NESTBOARD_DATABASE_URL=postgresql+asyncpg://nestboard:nestboard@localhost:5432/nestboard
# Used by the test suite only.
NESTBOARD_TEST_DATABASE_URL=postgresql+asyncpg://nestboard:nestboard@localhost:5432/nestboard_test
# Origins allowed to call the API from a browser (the Vite dev server).
NESTBOARD_CORS_ORIGINS=["http://localhost:5173"]
# Days a sign-in lasts without being used.
NESTBOARD_SESSION_DAYS=30
# Send the sign-in cookie over HTTPS only. Turn on whenever the server is reached over HTTPS.
NESTBOARD_COOKIE_SECURE=false
