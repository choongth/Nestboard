# Settings for the production stack (docker-compose.prod.yml). Copy this file
# to .env and fill it in; .env holds secrets, so never share or commit it.

# Password of the production database. Required: pick a long random one of
# letters, digits and - _ . ~ only (it goes into a database address, where
# @ / : # % $ and the like break it), e.g. from `openssl rand -hex 32`.
NESTBOARD_DB_PASSWORD=

# Port on this machine where the app is served.
NESTBOARD_PORT=8080

# The address people open, as the browser shows it.
NESTBOARD_SITE=http://localhost:8080

# true once the site is served over HTTPS (see frontend/Caddyfile).
NESTBOARD_COOKIE_SECURE=false
